@PACKAGE_INIT@

# CMake package configuration for DegorasKinesis (find_package(DegorasKinesis CONFIG)).
# Provides the imported target:  Degoras::Kinesis

include(CMakeFindDependencyMacro)

# Make the Find modules shipped alongside this config (e.g. FindThorlabsKinesis.cmake) discoverable.
list(PREPEND CMAKE_MODULE_PATH "${CMAKE_CURRENT_LIST_DIR}")

# For a STATIC build the private Thorlabs dependency is part of the link interface and must be re-located here; for a
# SHARED build it is sealed inside the DLL and this line is empty.
@LK_THORLABS_FIND_DEPENDENCY@

include("${CMAKE_CURRENT_LIST_DIR}/DegorasKinesisTargets.cmake")

check_required_components(DegorasKinesis)

@PACKAGE_INIT@

# Export the targets
include("${CMAKE_CURRENT_LIST_DIR}/@LEOBASE_NAME@Targets.cmake")

# set CMAKE_MODULE_PATH to find custom cmake modules
set(LEOBASE_MODULE_DIR "${CMAKE_CURRENT_LIST_DIR}/cmake/CMakeModules@LEOBASE_NAME@")

# Only add if the directory exists
if(EXISTS "${LEOBASE_MODULE_DIR}")
    list(APPEND CMAKE_MODULE_PATH "${LEOBASE_MODULE_DIR}")
endif()

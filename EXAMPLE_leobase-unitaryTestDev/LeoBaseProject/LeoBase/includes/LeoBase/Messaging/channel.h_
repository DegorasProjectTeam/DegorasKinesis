#ifndef __LEOBASE_MESSAGE_PASSING_CHANNEL_HPP__
#define __LEOBASE_MESSAGE_PASSING_CHANNEL_HPP__

#include <vector>
#include <list>
#include <algorithm>
#include <atomic>

#if defined(USE_BOOST)
    #include <boost/shared_ptr.hpp>
    #define CHANNEL_NAMESPACE boost
#else
    #include <memory>
    #define CHANNEL_NAMESPACE std
#endif

#include <LeoBase/Lockable/Lockable.hpp>
#include <LeoBase/ClassPatterns/Observer.hpp>
#include <LeoBase/ClassPatterns/Observable.hpp>

#include <LeoBase/MessagePassing/IEvent.hpp>

namespace LeoBase 
{
    /**
    * @brief The Channel class 
    * This class defines methods for communication between subscribers and external/internal application using a generic type of data
    */
    class Channel : public LeoBase::Observable<CHANNEL_NAMESPACE::shared_ptr<IEvent> >
    {
        typedef std::list<CHANNEL_NAMESPACE::shared_ptr<IEvent> > Events;
        typedef std::vector<CHANNEL_NAMESPACE::shared_ptr<Observer<CHANNEL_NAMESPACE::shared_ptr<IEvent> > > > Observers;
    public:
        Channel ()
        {
            observersDirty_ = false;
            dispatching_ = false;
            insertionEventsQueue_.value.clear();
            dispatchEventsQueue_.value.clear();
            updateObservers_.value.clear();
        }
        Channel(const Channel &) {};
        virtual ~Channel() {};

        /**
         * @brief pushEvent method to queue items into this channel
         * @param Event the item to queue
         */
        void pushEvent(CHANNEL_NAMESPACE::shared_ptr<IEvent> e) 
        {
            insertionEventsQueue_.lock();
            {
                insertionEventsQueue_.value.push_back(CHANNEL_NAMESPACE::move(e));
            }
            insertionEventsQueue_.unlock();
        }
    
       /**
         * @brief dispatchItems execute and purge the events queue 
         * @return 
         * XXX Risk notify->update should no fire exception, otherwise it might produce deadlock
         */
        void dispatchEvents()
        {
            if (dispatching_ ) return;
            dispatching_ = true;

            Events insertionEventsQueue;
               
            insertionEventsQueue_.lock();
            insertionEventsQueue = insertionEventsQueue_.value;
            insertionEventsQueue_.value.clear();
            insertionEventsQueue_.unlock();

            dispatchEventsQueue_.lock();
            {
                if (!dispatchEventsQueue_.value.empty())
                     dispatchEventsQueue_.value.insert(dispatchEventsQueue_.value.end(), insertionEventsQueue.begin(), insertionEventsQueue.end());
                else
                    dispatchEventsQueue_.value.swap(insertionEventsQueue);
            }
            dispatchEventsQueue_.unlock();

            if (observersDirty_) 
            {
                dispatching_ = false;
                return; 
            }

            Events dispatchEventsQueue = dispatchEventsQueue_.clone();

            if (!dispatchEventsQueue.empty())
            {
                for(auto & it: dispatchEventsQueue)
                {
                    notify(it);
                }

                dispatchEventsQueue.clear();
                dispatchEventsQueue_ = dispatchEventsQueue;
            }
            dispatching_ = false;
        }
      
       /**
         * @brief subscribe method to subscribe to this channel, this makes the observer to get 
         * channel events.
         * @param observer the observer that subscribes
         */
        void addObserver(CHANNEL_NAMESPACE::shared_ptr<Observer<CHANNEL_NAMESPACE::shared_ptr<IEvent> > > observer)
        {
            observersDirty_ = true;
            updateObservers_.lock();
            {
                if (std::find(updateObservers_.value.begin(), updateObservers_.value.end(), observer) == updateObservers_.value.end())
                {
                    updateObservers_.value.push_back(observer);
                }
            }
            updateObservers_.unlock();
            observersDirty_ = false;
        }

       /**
         * @brief unsubscribe method
         * @param observer the observer that subscribes
         */
        void removeObserver(CHANNEL_NAMESPACE::shared_ptr<Observer<CHANNEL_NAMESPACE::shared_ptr<IEvent> > >observer)
        {
            observersDirty_ = true;
            updateObservers_.lock();
            {
                auto position = std::find(updateObservers_.value.begin(), updateObservers_.value.end(), observer);
                if (position != updateObservers_.value.end())
                    updateObservers_.value.erase(position);
            }
            updateObservers_.unlock();
            observersDirty_ = false;
        }


        bool notify(const CHANNEL_NAMESPACE::shared_ptr<IEvent>& t)
        {
            bool retValue = false;
            Observers observers = updateObservers_.clone();
            for (auto &it : observers)
            {
                bool retValue = it->update(t);
                if (retValue)
                    break;
            }
            return retValue;
        }

    protected:
        std::atomic<bool> observersDirty_;
        std::atomic<bool> dispatching_;
        Lockable<Events> insertionEventsQueue_;
        Lockable<Events> dispatchEventsQueue_;
        Lockable<Observers> updateObservers_;
    };
}
#undef CHANNEL_NAMESPACE
#endif

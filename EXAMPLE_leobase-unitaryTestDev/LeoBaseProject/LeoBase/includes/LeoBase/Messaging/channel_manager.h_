#ifndef __LEOBASE_MESSAGE_PASSING_CHANNELMANAGER_HPP__
#define __LEOBASE_MESSAGE_PASSING_CHANNELMANAGER_HPP__ 1

#include <map>

#include <LeoBase/MessagePassing/Channel.hpp>

namespace LeoBase
{
    /**
     * @brief The ChannelManager 
     * Singleton used to manage the different channels that exists in the application.
     */
    class ChannelManager
    {
    public:
        static ChannelManager& instance()
        {
            if (!channelManager)
            {
                channelManager = new ChannelManager();
                atexit(&destroySingleton);
            }
            return *channelManager;
        }

        /**
         * Destructor
         */
        virtual ~ChannelManager();

        /**
         * @brief addChannel method to add a new channel
         * @param channelId the Identification token of the channel
         * @param channel The channel object.
         * @return
         */
        bool addChannel(const std::string &channelId, Channel*  channel);
        
        /**
         * @brief getChannel method to get a specific channel
         * @param channelId The identification token of the channel
         * @return
         */
        Channel * getChannel(const std::string &channelId);

        /**
         * @brief removeChannel remove communication channel
         * @param channelId The identification token of the channel
         * @return
         */
        bool removeChannel(const std::string &channelId);


        /**
         * @brief dispatch all channel registered events 
         * @return
         */
        void dispatchAllEvents();

    protected:
        /**
         * @brief ChannelManager Base Constructor
         */
        ChannelManager();

        /**
         * @brief Channel Manager copy constructor
         */
        ChannelManager(const ChannelManager & ) ;

        /**
         * @brief operator  override reference operator
         * @return
         */
        ChannelManager &operator= (const ChannelManager & );

    private:

        typedef std::map< std::string, Channel* > ChannelMap;

        ChannelMap channels;

        static ChannelManager* channelManager;

        static void destroySingleton()
        {
            if(channelManager != NULL) delete channelManager;
        }
    };
}

#endif

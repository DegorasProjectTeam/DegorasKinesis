{
  "version": 10,

  "configurePresets": 
  [
    {
      "name": "leo-ucrt64",
      "hidden": true,
      "generator": "Ninja",
      "condition": 
	  {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      },
	  
	  "cmakeExecutable": "$env{UCRT64_ROOT}/bin/cmake.exe",
      
	  "cacheVariables": 
	  {
        "CMAKE_SYSTEM_NAME": "Windows",
        "CMAKE_SYSTEM_PROCESSOR": "x86_64",
        "CMAKE_CXX_COMPILER": "$env{UCRT64_ROOT}/bin/g++.exe",
        "CMAKE_C_COMPILER": "$env{UCRT64_ROOT}/bin/gcc.exe",
        "CMAKE_MAKE_PROGRAM": "$env{UCRT64_ROOT}/bin/ninja.exe",
        "CMAKE_FIND_PACKAGE_PREFER_CONFIG": "ON",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "CMAKE_COLOR_DIAGNOSTICS": "ON",
		"CMAKE_INSTALL_PREFIX": "$env{LEO_DEVDRIVE}/deploys"
      },
	  "environment": 
	  {
        "PATH": "$env{UCRT64_ROOT}/bin;$penv{PATH}"
      }
    },
	
	{
      "name": "qtcreator-leo-ucrt64",
	  "hidden": true,
      "inherits": "leo-ucrt64",
      "vendor": 
	  {
        "qt.io/QtCreator/1.0": 
		{
          "AskBeforePresetsReload": false,
          "AskReConfigureInitialParams": false,
          "AutorunCMake": false,
          "PackageManagerAutoSetup": false,
          "ShowAdvancedOptionsByDefault": true,
		  "ShowSourceSubfolders": true,
          "UseJunctionsForSourceAndBuildDirectories": true,
          "debugger": 
		  {
            "DisplayName": "LEO-UCRT64-GDB",
            "Abis": ["x86-windows-msys-pe-64bit"],
            "Binary": "$env{UCRT64_ROOT}/bin/gdb.exe",
            "EngineType": 1
          }
        }
      }
    },
	
    {
      "name": "leo-ucrt64-deb",
      "inherits": "leo-ucrt64",
      "binaryDir": "$env{LEO_DEVDRIVE}/buildtrees/${sourceDirName}/leo-ucrt64-deb",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },

    {
      "name": "leo-ucrt64-rel",
      "inherits": "leo-ucrt64",
      "binaryDir": "$env{LEO_DEVDRIVE}/buildtrees/${sourceDirName}/leo-ucrt64-rel",
      "cacheVariables": 
	  {
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
	
	{
      "name": "qtcreator-leo-ucrt64-deb",
      "inherits": "qtcreator-leo-ucrt64",
      "binaryDir": "$env{LEO_DEVDRIVE}/buildtrees/${sourceDirName}/qtcreator-leo-ucrt64-deb",
      "cacheVariables": 
	  {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },

    {
      "name": "qtcreator-leo-ucrt64-rel",
      "inherits": "qtcreator-leo-ucrt64",
      "binaryDir": "$env{LEO_DEVDRIVE}/buildtrees/${sourceDirName}/qtcreator-leo-ucrt64-rel",
      "cacheVariables": 
	  {
        "CMAKE_BUILD_TYPE": "Release"
      }
    }
  ],

  "buildPresets": 
  [
    {
      "name": "leo-ucrt64-deb",
      "configurePreset": "leo-ucrt64-deb",
      "jobs": 0,
      "verbose": true
    },
    {
      "name": "leo-ucrt64-rel",
      "configurePreset": "leo-ucrt64-rel",
      "jobs": 0,
      "verbose": true
    }
  ]
}
